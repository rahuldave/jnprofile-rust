{
  "schema": "https://rahuldave.github.io/agent_skill_package_maker/schema/skill-package.v1.json",
  "version": 1,
  "repository": {
    "owner": "rahuldave",
    "name": "jnprofile-rust",
    "url": "https://github.com/rahuldave/jnprofile-rust"
  },
  "skills": [
    {
      "name": "rust-profile",
      "path": ".agents/skills/rust-profile"
    }
  ],
  "install_extras": {
    "files": [
      ".agents/just/rust",
      ".agents/targets/rust"
    ]
  },
  "executables": {
    "required": [
      {
        "name": "cargo",
        "check": "cargo --version",
        "description": "Builds, checks and tests the code. Install Rust with rustup: https://rustup.rs/. The profile installs the rest with rustup and cargo."
      },
      {
        "name": "just",
        "check": "just --version"
      },
      {
        "name": "uv",
        "check": "uv --version",
        "description": "Runs diff-cover and the helper script of the steps."
      }
    ],
    "optional": []
  },
  "npx": {
    "supported": false
  }
}
